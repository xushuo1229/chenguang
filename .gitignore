# ============================================================
# 知行 .gitignore
# ============================================================

# ---------- 依赖 ----------
node_modules/
server/node_modules/

# ---------- 环境变量 (敏感信息, 绝不提交) ----------
.env
.env.local
.env.*.local
server/.env

# ---------- Vercel ----------
.vercel/
server/.vercel/

# ---------- 构建产物 ----------
dist/
build/
*.log
.pwtest/

# ---------- 本地数据库 ----------
*.db
*.db-journal
*.db-shm
*.db-wal

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地临时产物（浏览器 profile / 走查截图 / 冒烟脚本等，2026-09-19） ----------
tmp-*
.tmp-*

# ---------- 工作区内部 ----------
.workbuddy/
archive/

# review scratch / Codex local config
_diff*
_rv_*
_review_*
.codex/
.claude/settings.local.json
