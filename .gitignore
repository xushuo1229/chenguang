# ============================================================
# 晨光自律台 .gitignore
# ============================================================

# ---------- 依赖 ----------
node_modules/
server/node_modules/

# ---------- 环境变量 (敏感信息, 绝不提交) ----------
.env
.env.local
.env.*.local
server/.env

# ---------- Vercel ----------
.vercel/
server/.vercel/

# ---------- 构建产物 ----------
dist/
build/
*.log

# ---------- 本地数据库 ----------
*.db
*.db-journal

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 工作区内部 ----------
.workbuddy/
archive/
