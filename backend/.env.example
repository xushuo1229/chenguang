# ============================================================
# 晨光自律台 · 后端环境变量示例
# 复制为 .env 并按需修改；生产环境必须填写带 [必填] 标记的项
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=development                # development | production
PORT=3000                           # 服务端口

# ---------- 数据库 (SQLite) ----------
# 数据库文件路径；默认位于 backend/chenguang.db
DB_PATH=./chenguang.db

# ---------- JWT ----------
# [生产必填] JWT 签名密钥；开发环境可使用下方默认值
JWT_SECRET=chenguang_dev_secret_change_me
JWT_EXPIRES_IN=30d                  # Token 有效期

# ---------- CORS ----------
# 允许的前端来源（逗号分隔）；开发环境留空表示放行所有来源
# 生产示例：https://xushuo1229.github.io,https://chenguang.example.com
CORS_ORIGIN=

# ---------- 请求限制 ----------
BODY_LIMIT=2mb                      # 请求体大小上限
RATE_LIMIT_MAX=100                  # 全局 /api 每分钟最大请求数
RATE_LIMIT_WINDOW_MS=60000          # 全局限流窗口（毫秒）

# ---------- BCrypt ----------
BCRYPT_ROUNDS=10                    # 密码哈希轮次（10 ≈ 100ms）

# ---------- AI 教练（Phase 13 AI 2.0 · OpenAI 兼容代理） ----------
# [可选] 填 AI_API_KEY 后 AI 教练即可用；为空则前端展示友好离线提示
AI_PROVIDER=openaiCompatible               # Provider Adapter 名称（见 src/services/providers/）
AI_API_KEY=                                # 大模型密钥（如 DeepSeek）；只存在后端，绝不下发浏览器
AI_BASE_URL=https://api.deepseek.com/v1    # OpenAI 兼容基址
AI_MODEL=deepseek-chat                     # 模型名
AI_TIMEOUT_MS=30000                        # 请求超时（毫秒）
AI_MAX_MESSAGES=20                         # 单轮对话历史条数上限
AI_MAX_MSG_LENGTH=8000                     # 单条消息长度上限
AI_MAX_CONTEXT_CHARS=24000                 # Context JSON 字符上限

# ---------- 静态托管（可选） ----------
# 设置后将由本服务托管前端构建产物，避免跨域
# STATIC_DIR=../dist

# ---------- 课表导入（代理抓取外部课表 HTML） ----------
# 通过学校课表页面链接抓取并解析课程；链接需可公开访问、无需登录
# IMPORT_TIMEOUT_MS=15000            # 抓取超时（毫秒）
# IMPORT_MAX_URL_LEN=2000            # URL 长度上限
# IMPORT_MAX_COURSE=50               # 单次最多导入课程数

# ---------- Supabase Realtime（可选，排行榜/动态推送） ----------
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_ANON_KEY=
