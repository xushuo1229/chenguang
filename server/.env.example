# ============================================================
# 晨光自律台 后端环境变量模板
# 复制为 .env 并填入真实值 (.env 已在 .gitignore 中, 不会提交)
# ============================================================

# 运行环境: development | production
NODE_ENV=development
PORT=3000

# ----- Supabase 项目信息 -----
# Supabase Dashboard → Settings → API
# 用于前端直连 (可选, 当前后端使用 DATABASE_URL 通过 pg 连接)
SUPABASE_URL=https://your-project-ref.supabase.co
# anon key — 可暴露给前端 (用于 Realtime 订阅), 安全
SUPABASE_ANON_KEY=your-supabase-anon-key
# service_role key — 仅后端使用 (广播 Realtime 消息), 绝不暴露给前端!
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ----- Supabase PostgreSQL 连接 -----
# Supabase Dashboard → Settings → Database → Connection string
# 推荐 Transaction Pooler (端口 6543) 以适配 serverless 短连接
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 连接池大小 (serverless 建议 3-5, 本地可 10)
DB_POOL_MAX=5

# ----- JWT 配置 -----
# 密钥: 生产环境请使用强随机串 (生成命令: openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-change-me
# 过期时间: 如 7d / 24h / 1h
JWT_EXPIRES_IN=7d

# ----- CORS -----
# 允许的前端来源 (逗号分隔多个域名)
# 生产环境: GitHub Pages 域名 + Vercel API 域名
# 开发环境: localhost / 127.0.0.1
CORS_ORIGIN=https://xushuo1229.github.io,http://127.0.0.1:8000,http://localhost:8000

# ----- 限流 -----
# 每个时间窗口内单 IP 的最大请求数
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ----- 请求体大小限制 -----
# 防止超大请求体耗尽内存 (默认 1mb, 生产建议 512kb)
BODY_LIMIT=1mb

# ----- BCrypt -----
# 哈希轮数 (10-12 之间, 越大越安全但越慢)
BCRYPT_ROUNDS=10
